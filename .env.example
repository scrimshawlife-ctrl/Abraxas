# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- Sessions ---
SESSION_SECRET=change-me-long-random

# --- Optional LLMs + X ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
X_BEARER=

# --- Database (SQLite default) ---
DATABASE_URL=file:./abraxas.db

# --- Governance (cryptographic receipt signing) ---
# HMAC-SHA256 secret key for signing governance receipts
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ABX_GOV_HMAC_KEY=change-me-use-strong-random-secret

# --- ALIVE System ---
# HMAC-SHA256 secret for signing ALIVE exports (field signatures)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ALIVE_EXPORT_SECRET=

# --- Research RAG Phase 0 (Notion SoT; shadow / not Canon) ---
# Token via env only. Do not commit secrets. No paid embed calls.
NOTION_TOKEN=
NOTION_VERSION=2025-09-03
ABX_RESEARCH_RAG_RECEIPTS_DATA_SOURCE=5d4697c5-04cd-494a-aa10-d8eac2477dfb
ABX_RESEARCH_RAG_CHUNKS_DATA_SOURCE=8781a2f5-928e-4355-8abc-7d0ef1f9da8d
ABX_RESEARCH_RAG_REGISTRY_DATA_SOURCE=f17f06cb-a241-4c00-bc89-dd789b8f3759
ABX_RESEARCH_RAG_TIMEOUT_S=30
ABX_RESEARCH_RAG_MAX_RETRIES=4