{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ABX-NOEMA-REP-001 candidate review manifest",
  "description": "Draft metadata sidecar only; not a runtime API or execution grant. Reference integrity and dependency semantics require separate review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "experiment_id",
    "status",
    "authority",
    "components",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-candidate"
    },
    "program_id": {
      "const": "ABX-NOEMA-REP-001"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate"
    },
    "authority": {
      "const": "ADVISORY_ONLY"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "required",
          "contract_ref",
          "status",
          "artifacts",
          "reason"
        ],
        "properties": {
          "component": {
            "enum": [
              "noema",
              "noema-client",
              "hyperlexical",
              "semion",
              "noesis",
              "trutina",
              "abraxas"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "contract_ref": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "NOT_EXECUTED",
              "AVAILABLE",
              "NOT_COMPUTABLE"
            ]
          },
          "artifacts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/artifact"
            },
            "uniqueItems": true
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "AVAILABLE"
                }
              }
            },
            "then": {
              "properties": {
                "artifacts": {
                  "minItems": 1
                },
                "reason": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "artifacts": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "text",
          "depends_on",
          "label",
          "evidence",
          "reason"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "noema",
                "noema-client",
                "hyperlexical",
                "semion",
                "noesis",
                "trutina",
                "abraxas"
              ]
            }
          },
          "label": {
            "enum": [
              "OBSERVED",
              "INFERRED",
              "SPECULATIVE",
              "NOT_COMPUTABLE"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/artifact"
            },
            "uniqueItems": true
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "label": {
                  "enum": [
                    "OBSERVED",
                    "INFERRED"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "label": {
                  "const": "NOT_COMPUTABLE"
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256",
        "hash_kind"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "hash_kind": {
          "const": "raw-bytes-sha256"
        }
      }
    }
  }
}
